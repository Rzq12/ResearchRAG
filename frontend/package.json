{
  "name": "researchrag-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React frontend for ResearchRAG — talks to the FastAPI wrapper over the existing backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
