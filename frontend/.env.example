# Base URL of the ResearchRAG FastAPI backend (the thin wrapper in ../api).
#
# Local development (uvicorn on port 8000):
VITE_API_BASE_URL=http://localhost:8000
#
# Production examples (set this in Vercel → Project → Settings → Environment
# Variables, NOT committed):
#   VITE_API_BASE_URL=https://<your-hf-space>.hf.space
#   VITE_API_BASE_URL=https://<your-app>.up.railway.app
