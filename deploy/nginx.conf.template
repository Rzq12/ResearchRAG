# Reverse proxy that lets ONE container (one HF Space / one Railway service)
# serve BOTH apps on a single public port:
#   /api/*, /docs, /openapi.json, /redoc  → FastAPI  (uvicorn, 127.0.0.1:8000)
#   everything else (incl. Streamlit WS)  → Streamlit (127.0.0.1:8503)
#
# ${NGINX_PORT} is substituted at container start from $PORT (Railway) or the
# HF app_port default (8501). See deploy/start.sh.

server {
    listen ${NGINX_PORT};
    server_name _;

    # Large PDF uploads go through /api/documents/upload.
    client_max_body_size 40m;

    # ── FastAPI (React frontend talks to these) ──────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Streaming chat (SSE) must not be buffered.
        proxy_buffering    off;
        proxy_read_timeout 300s;
    }

    location ~ ^/(docs|redoc|openapi\.json)$ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
    }

    # ── Streamlit (unchanged app, incl. its websocket at /_stcore/stream) ────
    location / {
        proxy_pass         http://127.0.0.1:8503;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # WebSocket upgrade for Streamlit's live connection.
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
