# Reverse proxy that lets ONE container (one HF Space / one Railway service)
# serve BOTH apps on a single public port:
#   /api/*, /docs, /openapi.json, /redoc  → FastAPI  (uvicorn, 127.0.0.1:8000)
#   everything else (incl. Streamlit WS)  → Streamlit (127.0.0.1:8503)
#
# ${NGINX_PORT} is substituted at container start from $PORT (Railway) or the
# HF app_port default (8501). See deploy/start.sh.

# NOTE: this file is included inside nginx's http{} block (conf.d/*.conf), so
# only http-context directives belong here — and only ones the distro's
# nginx.conf has not already set. Debian's stock nginx.conf declares `gzip on;`
# at http level, so re-declaring it here is a hard "duplicate directive" error.
# All compression settings therefore live inside server{} below, which is a
# valid context for every gzip_* directive and cannot collide.
#
# The pid path is handled in the Dockerfile by making /var/run/nginx.pid
# writable by appuser.

server {
    listen ${NGINX_PORT};
    server_name _;

    # ── Compression (server context — see note above) ────────────────────────
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_comp_level   5;
    gzip_types        text/plain text/css application/json application/javascript
                      text/xml application/xml application/xml+rss text/javascript
                      image/svg+xml;

    # Large PDF uploads go through /api/documents/upload. Keep this at or above
    # MAX_UPLOAD_MB so the app returns a clean 413/422 instead of nginx cutting
    # the connection.
    client_max_body_size 40m;

    # Don't advertise the exact nginx version to attackers.
    server_tokens off;

    # ── Security headers (applied to every response, including errors) ───────
    # HSTS: the platform terminates TLS in front of us; this tells browsers to
    # never try plain HTTP again.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # This origin serves Streamlit, which must never be framed (clickjacking).
    add_header X-Frame-Options            "DENY"            always;
    add_header X-Content-Type-Options     "nosniff"         always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy         "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin"     always;

    # ── FastAPI (React frontend talks to these) ──────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Streaming chat (SSE) must not be buffered.
        proxy_buffering    off;
        proxy_read_timeout 300s;
    }

    location ~ ^/(docs|redoc|openapi\.json)$ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
    }

    # ── Streamlit (unchanged app, incl. its websocket at /_stcore/stream) ────
    location / {
        proxy_pass         http://127.0.0.1:8503;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # WebSocket upgrade for Streamlit's live connection.
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
