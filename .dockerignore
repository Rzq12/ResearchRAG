# Secrets — NEVER bake into the image (pass at runtime: --env-file .env)
.env

# Local data: ChromaDB index + auth DB (mounted as a volume instead)
data/

# Virtualenv & caches (huge; image installs its own deps)
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# VCS & CI
.git/
.github/
.gitignore

# Dev-only: tests & eval run outputs (eval harness itself is kept so
# `python -m eval.run_eval` works inside the container)
tests/
eval/results/

# React frontend — deployed separately to Vercel, not needed in this image
# (node_modules alone is huge). The backend container only serves Streamlit+API.
frontend/
**/node_modules/

# Knowledge-graph output & agent scratch
graphify-out/
.agents/
skills-lock.json

# Docs & local artifacts
README.md
PLAN_UPGRADE_RAG.md
*.log
.DS_Store
Thumbs.db
