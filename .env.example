# Copy this to .env and fill in your values
# Get Groq API key free at: https://console.groq.com

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional tweaks
CHROMA_PATH=./data/chroma_db
TOP_K_RETRIEVAL=15
TOP_K_OPENALEX=5
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Chunking — legacy (abstract/short text)
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Chunking — advanced PDF pipeline (parent-child)
CHILD_CHUNK_WORDS=180
CHILD_CHUNK_OVERLAP_WORDS=30
PARENT_CHUNK_WORDS=700
CHILDREN_PER_PARENT=4

# RAG quality
# NOTE: With parent-child retrieval, threshold acts as a SOFT check only.
# The system won't filter individual child chunks by this — it only rejects
# a query if the BEST child candidate score is < SIMILARITY_THRESHOLD / 2.
# Recommended: 0.05–0.15 (lower = more permissive; higher = stricter)
SIMILARITY_THRESHOLD=0.1
MAX_TOKENS_RESPONSE=2000

# Reranker (optional, downloads ~80MB model on first use)
ENABLE_RERANKER=false

# Full-text fetching (Semantic Scholar + Unpaywall)
FULLTEXT_MAILTO=           # email for Unpaywall polite pool (falls back to OPENALEX_MAILTO)
FULLTEXT_MAX_PDF_MB=30
