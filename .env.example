# Copy this to .env and fill in your values
# Get Groq API key free at: https://console.groq.com

GROQ_API_KEY=
# Default LLM (auto-routed: "gemini-*" → Gemini, "hf:*" → self-hosted, else Groq).
# Old name GROQ_MODEL still works as an alias.
DEFAULT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Google Gemini — get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Self-hosted model (your own fine-tuned model behind an OpenAI-compatible
# endpoint: vLLM / TGI / HF Inference). When URL + model name are set, the
# model appears in the UI as "hf:<HF_MODEL_NAME>".
HF_ENDPOINT_URL=
HF_API_TOKEN=
HF_MODEL_NAME=

# ── FastAPI wrapper (for the React frontend) ──────────────────────────────────
# Only used by api/ — the Streamlit app ignores everything in this block.

# Environment. Anything other than "development" enforces the production
# guardrails: JWT_SECRET and CORS_ORIGINS become mandatory and /docs is hidden.
ENVIRONMENT=development

# REQUIRED in staging/production. Signs the JWT access tokens — rotating it
# invalidates every active session. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank in development, where an ephemeral secret is generated per process.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Allowed browser origins for the REST API (comma-separated). REQUIRED in
# staging/production — set it to your exact Vercel URL. Wildcards are rejected:
# this API can delete a user's entire library, so any origin must be explicit.
#   CORS_ORIGINS=https://research-rag.vercel.app
CORS_ORIGINS=http://localhost:5173

# Expose /docs and /openapi.json in production (default false — the schema
# advertises the full attack surface).
EXPOSE_DOCS=false

# Optional tweaks
CHROMA_PATH=./data/chroma_db
TOP_K_RETRIEVAL=15
TOP_K_OPENALEX=5
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Embedding (multilingual, runs locally). Changing the model changes vector
# dimensionality → re-index required: python -m scripts.reindex --apply
# Lighter alternative for small containers: intfloat/multilingual-e5-small
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Chunking — legacy (abstract/short text)
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Chunking — advanced PDF pipeline (parent-child)
CHILD_CHUNK_WORDS=180
CHILD_CHUNK_OVERLAP_WORDS=30
PARENT_CHUNK_WORDS=700
CHILDREN_PER_PARENT=4

# RAG quality
# Legacy soft check, only used when the reranker is disabled.
SIMILARITY_THRESHOLD=0.1
MAX_TOKENS_RESPONSE=2000

# Reranker (multilingual cross-encoder; scores sigmoid-normalized to [0,1])
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_K=5
RERANK_MAX_CANDIDATES=20

# Hybrid retrieval: BM25 keyword search fused with vector search (RRF)
ENABLE_BM25=true
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
BM25_MAX_CORPUS=20000

# HyDE — hypothetical document embeddings (costs 2 extra LLM calls per query)
ENABLE_HYDE=true
HYDE_NUM_HYPOTHETICALS=2
HYDE_TEMPERATURE=0.9
HYDE_MAX_TOKENS=150

# Relevance threshold on the reranker top-1 score. Below it, answer context
# comes from live sources (OpenAlex → DuckDuckGo) instead of the local KB.
RELEVANCE_THRESHOLD=0.5
ENABLE_WEB_FALLBACK=true
FALLBACK_MAX_RESULTS=3

# Reasoning: model thinks inside <think>...</think> before the final answer;
# shown in the UI as a collapsible "Reasoning" block.
ENABLE_REASONING=true

# Full-text fetching (Semantic Scholar + Unpaywall)
FULLTEXT_MAILTO=           # email for Unpaywall polite pool (falls back to OPENALEX_MAILTO)
FULLTEXT_MAX_PDF_MB=30
