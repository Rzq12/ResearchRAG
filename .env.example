# Copy this to .env and fill in your values
# Get Groq API key free at: https://console.groq.com

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional tweaks
CHROMA_PATH=./data/chroma_db
TOP_K_RETRIEVAL=6
TOP_K_OPENALEX=5
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# RAG quality
SIMILARITY_THRESHOLD=0.2
MAX_TOKENS_RESPONSE=1500

# Full-text fetching (Semantic Scholar + Unpaywall)
FULLTEXT_MAILTO=           # email for Unpaywall polite pool (falls back to OPENALEX_MAILTO)
FULLTEXT_MAX_PDF_MB=30
